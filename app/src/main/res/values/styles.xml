<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Style untuk rounded corner (jika ada) -->
    <style name="RoundedCorner12">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Style indikator aktif BottomNavigationView (Material 3) -->
    <style name="BottomNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:background">@drawable/bg_bottom_nav_indicator</item>
        <!-- Dimensi default Material 3 adalah 24dp, tapi kita eksplisitkan -->
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
    </style>

</resources>