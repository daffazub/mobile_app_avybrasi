<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F0E8">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:paddingHorizontal="16dp"
        android:paddingTop="40dp"
        android:paddingBottom="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Riwayat Komisi"
                android:textColor="#C9A84C"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tren komisi kamu"
                android:textColor="#888888"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvAffFilterPeriode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bulan Ini ▾"
            android:textColor="#1A1A1A"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#C9A84C"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"/>
    </LinearLayout>

    <!-- Stats strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2A2A2A"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:orientation="horizontal">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total Komisi" android:textColor="#888888" android:textSize="10sp"/>
            <TextView android:id="@+id/tvAffTotalKomisiStat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp 0" android:textColor="#C9A84C" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#3A3A3A" android:layout_marginHorizontal="8dp"/>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Transaksi" android:textColor="#888888" android:textSize="10sp"/>
            <TextView android:id="@+id/tvAffJmlTransaksi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#3A3A3A" android:layout_marginHorizontal="8dp"/>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rata-rata" android:textColor="#888888" android:textSize="10sp"/>
            <TextView android:id="@+id/tvAffRataRata" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp 0" android:textColor="#4CAF50" android:textSize="14sp" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

            <!-- Grafik -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Tren Komisi" android:textColor="#1A1A1A" android:textSize="14sp"
                android:textStyle="bold" android:layout_marginBottom="8dp"/>

            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="20dp" app:cardCornerRadius="12dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF">
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChartKomisi"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:padding="8dp"/>
            </androidx.cardview.widget.CardView>

            <!-- Riwayat list -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Riwayat Transaksi" android:textColor="#1A1A1A" android:textSize="14sp"
                android:textStyle="bold" android:layout_marginBottom="10dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAffKomisiRiwayat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="24dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>