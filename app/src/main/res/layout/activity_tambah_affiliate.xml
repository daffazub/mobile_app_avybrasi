<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F0E8">

    <!-- Header dengan back button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:padding="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tambah Affiliate Baru"
                android:textColor="#C9A84C"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daftarkan affiliate baru ke dalam sistem"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Tombol Batal -->
        <TextView
            android:id="@+id/btnBatal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <!-- Form Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Card Form -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Informasi Affiliate"
                        android:textColor="#1A1A1A"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                    <!-- Nama Lengkap -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nama Lengkap"
                        android:textColor="#1A1A1A"
                        android:textSize="12sp"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/etNamaLengkap"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Masukkan nama lengkap"
                        android:textColor="#1A1A1A"
                        android:textColorHint="#AAAAAA"
                        android:inputType="textPersonName"
                        android:background="@android:drawable/edit_text"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp"/>

                    <!-- Email -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textColor="#1A1A1A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp"/>

                    <EditText
                        android:id="@+id/etEmailAffiliate"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="email@gmail.com"
                        android:textColor="#1A1A1A"
                        android:textColorHint="#AAAAAA"
                        android:inputType="textEmailAddress"
                        android:background="@android:drawable/edit_text"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:layout_marginTop="4dp"/>

                    <!-- Password -->
                    <!-- Password dengan toggle mata -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password"
                        android:textColor="#1A1A1A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="4dp">

                        <EditText
                            android:id="@+id/etPasswordAffiliate"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:hint="Password untuk affiliate"
                            android:textColor="#1A1A1A"
                            android:textColorHint="#AAAAAA"
                            android:inputType="textPassword"
                            android:background="@android:drawable/edit_text"
                            android:paddingHorizontal="12dp"
                            android:textSize="14sp"
                            android:paddingEnd="40dp"/>

                        <ImageView
                            android:id="@+id/ivTogglePassword"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="8dp"
                            android:src="@android:drawable/ic_menu_view"
                            android:contentDescription="Toggle password"
                            android:clickable="true"
                            android:focusable="true"/>
                    </RelativeLayout>

                    <!-- Komisi Persen -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Komisi (%)"
                        android:textColor="#1A1A1A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp"/>

                    <EditText
                        android:id="@+id/etKomisiPersen"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="5"
                        android:textColor="#1A1A1A"
                        android:textColorHint="#AAAAAA"
                        android:inputType="numberDecimal"
                        android:background="@android:drawable/edit_text"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:text="5"
                        android:layout_marginTop="4dp"/>

                    <!-- Minimum Payout -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Minimum Payout (Rp)"
                        android:textColor="#1A1A1A"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp"/>

                    <EditText
                        android:id="@+id/etMinimumPayout"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="100000"
                        android:textColor="#1A1A1A"
                        android:textColorHint="#AAAAAA"
                        android:inputType="number"
                        android:background="@android:drawable/edit_text"
                        android:paddingHorizontal="12dp"
                        android:textSize="14sp"
                        android:text="100000"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tombol Submit -->
            <Button
                android:id="@+id/btnSubmitAffiliate"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Buat Affiliate"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:backgroundTint="#C9A84C"
                android:layout_marginTop="20dp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>