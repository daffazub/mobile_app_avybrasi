<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- background putih -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="8dp" />
            <stroke android:color="#FFCDD2" android:width="1dp" />
        </shape>
    </item>
    <!-- strip merah di kiri -->
    <item android:left="0dp" android:right="0dp" android:top="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#F44336" />
            <corners android:topLeftRadius="8dp" android:bottomLeftRadius="8dp"
                android:topRightRadius="0dp" android:bottomRightRadius="0dp" />
            <padding android:left="6dp" />
        </shape>
    </item>
</layer-list>